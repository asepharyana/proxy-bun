{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"bunVersion": "1",
	"installCommand": "bun install",
	"outputDirectory": "dist",
	"trailingSlash": false,
	"rewrites": [
		{
			"source": "/api",
			"destination": "/api/index.ts"
		},
		{
			"source": "/api/(.*)",
			"destination": "/api/index.ts"
		}
	]
}
