{
	"name": "proxy-bun",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "mkdir -p dist && cp public/index.html dist/index.html",
		"start": "bun run src/index.ts",
		"dev": "bun --hot run src/index.ts",
		"test": "bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "bunx tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "latest"
	}
}
